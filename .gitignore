# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# IDE
.idea/
.vscode/
*.swp
*.swo

# macOS
.DS_Store

# Environment / Secrets
.env
*.env
.env.local

# Supabase local
supabase/.temp/

# Supabase CLI binaries and downloads
supabase-go
supabase-*
*.tar.gz
!**/vendor/**/*.tar.gz

# Build outputs
*.tsbuildinfo

# Screenshots and artifacts
screenshots/
artifacts/

# But allow e2e test screenshots
!e2e/screens/*.png
!e2e/fixtures/*.jpg

# Playwright
playwright-report/
test-results/

# Built legal website (npm run legal:build)
web-legal/dist/

# Store credentials (never commit)
secrets/
*.p8
*.p12
*.jks
*.keystore
*.mobileprovision
google-play-service-account*.json

# Native folders are generated by `expo prebuild` (CNG). Never commit them,
# or EAS stops applying app.json native config (permissions, privacy manifest).
/ios
/android
