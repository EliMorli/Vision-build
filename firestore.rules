rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Users can CRUD their own projects
      match /projects/{projectId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Contractors: readable by authenticated users, writable by admins only
    match /contractors/{contractorId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin SDK only

      // Leads under a contractor: writable by Cloud Functions (admin),
      // readable by the contractor (future auth) or the user who created them
      match /leads/{leadId} {
        allow read: if request.auth != null
          && (resource.data.userId == request.auth.uid
              || resource.data.contractorId == contractorId);
        allow write: if false; // Cloud Functions only
      }
    }
  }
}
