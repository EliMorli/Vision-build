# ─── Expo App (bundled into the client) ─────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# Support email (leave blank to hide email button in app)
EXPO_PUBLIC_SUPPORT_EMAIL=

# ─── Development Flags (DO NOT USE IN PRODUCTION) ────────────
# Enables mock session and sample projects for local dev/testing.
# Only works when __DEV__ is true (development builds).
# Remove or set to false for production builds.
# EXPO_PUBLIC_DEV_MOCK_SESSION=true

# ─── Supabase Edge Function Secrets ─────────────────────────
# Set via CLI: supabase secrets set OPENAI_API_KEY=sk-...
# These are server-side only, never bundled into the app.
#
# OPENAI_API_KEY=sk-...
# REPLICATE_API_TOKEN=r8_...
# RESEND_API_KEY=re_...
#
# BUSINESS_MAILING_ADDRESS=YourCompany Inc., 123 Main St, City, ST 12345
# Required for CAN-SPAM compliance when sending contractor emails
#
# UNSUBSCRIBE_SECRET=random-secret-string-change-me
# Required for HMAC-signed unsubscribe links
#
# Rate Limits (optional, defaults shown):
# RATE_LIMIT_ANALYZE_ROOM=10
# RATE_LIMIT_GENERATE_DESIGN=5
# RATE_LIMIT_DISPATCH_LEAD=3
#
# Apple Sign-In (optional, for token revocation on account deletion):
# APPLE_TEAM_ID=YOUR_TEAM_ID
# APPLE_KEY_ID=YOUR_KEY_ID
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----...
# APPLE_CLIENT_ID=com.yourapp.service
#
# Auto-injected by Supabase runtime (don't set manually):
# SUPABASE_URL
# SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY
