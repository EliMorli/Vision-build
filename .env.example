# ─── Expo App (bundled into the client) ─────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# Support email (leave blank to hide email button in app)
EXPO_PUBLIC_SUPPORT_EMAIL=

# Where the legal website (web-legal/dist, built with `npm run legal:build`) is hosted.
# FILL-IN (Elimar). The app opens <base>/terms, /privacy and /licenses.
# Default is a placeholder; release CI fails until this is set to the real URL.
EXPO_PUBLIC_LEGAL_BASE_URL=

# Pros / outreach (off at launch; the Inbox tab is hidden while off)
# EXPO_PUBLIC_CONTRACTOR_OUTREACH_ENABLED=true

# ─── Development Flags (DO NOT USE IN PRODUCTION) ────────────
# Enables mock session and sample projects for local dev/testing.
# Only works when __DEV__ is true (development builds).
# Remove or set to false for production builds.
# EXPO_PUBLIC_DEV_MOCK_SESSION=true

# ─── Supabase Edge Function Secrets ─────────────────────────
# Set via CLI: supabase secrets set AI_API_KEY=sk-...
# These are server-side only, never bundled into the app.
#
# AI Layer (OpenRouter required in production):
# AI_API_KEY=sk-...                 # Your OpenRouter API key
# AI_BASE_URL=https://openrouter.ai/api/v1  # Default (required in production)
# 
# Model overrides (all must be on OpenRouter's ZDR list - run npm run check:models to verify):
# AI_MODEL_VISION=google/gemini-2.5-pro              # Vision model for room analysis
# AI_MODEL_TEXT=anthropic/claude-sonnet-5.5          # Text model for brief generation
# AI_MODEL_CHAT=anthropic/claude-sonnet-5.5          # Chat model for Vi assistant
# AI_MODEL_RENDER_PREVIEW=google/gemini-3.1-flash-image  # Quick preview (1 image, ~3 sec)
# AI_MODEL_RENDER_FINAL=google/gemini-3.1-flash-image    # Final generation (4 images)
#
# Environment (fail-closed for security):
# APP_ENV=development               # Only "development" or "staging" (case-insensitive) unlock non-prod behavior
#                                   # Missing, "production", or any other value → production mode
#                                   # Production enforces OpenRouter-only for data privacy
#
# Image Generation Provider:
# RENDER_PROVIDER=openrouter        # Default: openrouter (uses AI_API_KEY). Options: openrouter|mock
#                                   # No Replicate token is needed; Replicate is refused in production
#                                   # (APP_ENV != development|staging) and is dev/staging-only.
#
# Email:
# RESEND_API_KEY=re_...
#
# BUSINESS_MAILING_ADDRESS=YourCompany Inc., 123 Main St, City, ST 12345
# Required for CAN-SPAM compliance when sending contractor emails
#
# UNSUBSCRIBE_SECRET=random-secret-string-change-me
# Required for HMAC-signed unsubscribe links
#
# Rate Limits (optional, defaults shown):
# RATE_LIMIT_ANALYZE_ROOM=10
# RATE_LIMIT_GENERATE_DESIGN=5
# RATE_LIMIT_DISPATCH_LEAD=3
#
# Apple Sign-In (optional, for token revocation on account deletion):
# APPLE_TEAM_ID=YOUR_TEAM_ID
# APPLE_KEY_ID=YOUR_KEY_ID
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----...
# APPLE_CLIENT_ID=com.yourapp.service
#
# Auto-injected by Supabase runtime (don't set manually):
# SUPABASE_URL
# SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY
